---
import Base from '../layouts/Base.astro'
import { Content, getHeadings } from '../content/changelog.md'

// 版本标题形如「1.3.0 — 2026-10-05」，拆成版本号和日期给侧栏用
const versions = getHeadings()
  .filter((h) => h.depth === 2)
  .map((h) => {
    const [ver, date] = h.text.split(' — ')
    return { slug: h.slug, ver, date }
  })
---

<Base title="更新日志" description="Marlin 每个版本的变化。">
  <div class="wrap page">
    <aside>
      <h1>更新日志</h1>
      <nav aria-label="版本">
        {versions.map((v) => (
          <a href={`#${v.slug}`}>
            <span class="ver">{v.ver}</span>
            <span class="date">{v.date}</span>
          </a>
        ))}
      </nav>
    </aside>
    <article class="log">
      <Content />
    </article>
  </div>
</Base>

<style>
  .page {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 56px;
    padding-top: 64px;
  }
  aside {
    position: sticky;
    top: 92px;
    align-self: start;
  }
  h1 {
    font-size: 34px;
    margin-bottom: 24px;
  }
  nav {
    display: grid;
    border-left: 1px solid var(--border);
  }
  nav a {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 6px 12px;
    margin-left: -1px;
    border-left: 2px solid transparent;
    color: var(--fg);
    text-decoration: none;
    font-size: 14px;
  }
  nav a:hover {
    border-left-color: var(--accent);
    background: var(--hover);
  }
  .ver {
    font: 500 14px var(--font-mono);
  }
  .date {
    color: var(--fg-muted);
  }
  .log {
    max-width: 720px;
    font-size: 15.5px;
  }
  .log :global(h2) {
    font-size: 28px;
    margin: 72px 0 14px;
    padding-top: 20px;
    border-top: 1px solid var(--fg);
    scroll-margin-top: 80px;
  }
  .log :global(h2:first-of-type) {
    margin-top: 0;
  }
  .log :global(h3) {
    font-size: 18px;
    margin: 32px 0 8px;
  }
  .log :global(p) {
    margin: 0 0 12px;
  }
  .log :global(ul) {
    margin: 0 0 12px;
    padding-left: 1.3em;
  }
  .log :global(li) {
    margin: 4px 0;
  }
  .log :global(li::marker) {
    color: var(--fg-muted);
  }
  .log :global(code) {
    font: 0.88em var(--font-mono);
    background: var(--hover);
    padding: 0.1em 0.35em;
    border-radius: 4px;
  }
  @media (max-width: 820px) {
    .page {
      grid-template-columns: 1fr;
      gap: 24px;
      padding-top: 40px;
    }
    aside {
      position: static;
    }
    nav {
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      column-gap: 24px;
      border-left: 0;
    }
    nav a {
      border-left: 0;
      margin-left: 0;
      padding: 6px 0;
    }
  }
</style>

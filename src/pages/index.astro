---
import { Image } from 'astro:assets'
import Base from '../layouts/Base.astro'
import DownloadLinks from '../components/DownloadLinks.vue'
import PromoVideo from '../components/PromoVideo.vue'
import { latest } from '../lib/latest'
import { faqs } from '../lib/faq'
import { TOUR_CHAPTERS, TOUR_DURATION } from '../lib/tour'
import { downloadsFor, REPO_URL } from '../lib/release'
import { absUrl, url } from '../lib/url'
import { SLOGAN, SLOGAN_EN } from '../lib/brand'
import { VIDEO_VERSION } from '../lib/video'
// 截图来自 promo-video/scripts/capture（测试版 + 示例工作区，2 倍图）
import readingShot from '../assets/shots/reading.png'
import liveShot from '../assets/shots/live-table.png'
import flowShot from '../assets/shots/flow-5.png'
import seqShot from '../assets/shots/seq-4.png'
import mindShot from '../assets/shots/mind-4.png'
import gitShot from '../assets/shots/git-diff.png'
import presentShot from '../assets/shots/present-pen.png'

// 实测数据（主仓库 README「实测数据」）
const stats = [
  ['70', 'ms', '再开一个文件'],
  ['1.8', 's', '打开 10 MB 文档'],
  ['6.4', 'MB', '安装包']
]

const more = [
  ['打开文件夹', '整个仓库，即开即搜。'],
  ['数学公式', 'KaTeX 排版。'],
  ['导出', 'PDF、HTML，一键。'],
  ['主题', '一份 CSS，一套主题。'],
  ['自动更新', '新版本，点一下。'],
  ['便携版', '解压即用。']
]

const dl = downloadsFor(latest.version, latest.date)
const video = (name: keyof typeof VIDEO_VERSION) => url(`/video/${name}`) + '?v=' + VIDEO_VERSION[name]
const description =
  'Marlin（墨鳞）是 Windows 上免费的 Markdown 阅读器与编辑器：双击秒开，所见即所改；流程图、时序图、思维导图在画板里画，Git 同步，F5 放映。'
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Marlin',
    alternateName: '墨鳞',
    description,
    url: absUrl('/'),
    image: absUrl('/og.png'),
    screenshot: new URL(readingShot.src, absUrl('/')).href,
    applicationCategory: 'UtilitiesApplication',
    applicationSubCategory: 'Markdown 编辑器',
    operatingSystem: 'Windows 10, Windows 11',
    processorRequirements: 'x64',
    inLanguage: 'zh-CN',
    isAccessibleForFree: true,
    featureList: ['双击秒开', '实时预览编辑', '流程图、时序图、思维导图画板', 'Git 同步', 'F5 放映', '数学公式', '导出 PDF、HTML', '全目录搜索'],
    softwareVersion: latest.version,
    datePublished: latest.date,
    fileSize: '6.4 MB',
    downloadUrl: dl.setup.url,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'CNY' },
    author: { '@type': 'Organization', name: 'Marlin', url: absUrl('/'), sameAs: [REPO_URL] }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Marlin 墨鳞',
    url: absUrl('/'),
    inLanguage: 'zh-CN'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a }
    }))
  }
]
---

<Base fullTitle={`Marlin 墨鳞 - ${SLOGAN}`} description={description} jsonld={jsonld}>
  <section class="band hero">
    <div class="wrap">
      <!-- 名字先以 Markdown 源码出现，再「渲染」成标题：Marlin 实时预览做的就是这件事 -->
      <h1 class="name" id="headline"><span class="mk" aria-hidden="true">#&nbsp;</span>Marlin<i class="caret" aria-hidden="true"></i></h1>
      <script is:inline>
        ;(() => {
          const h = document.getElementById('headline')
          if (!h || matchMedia('(prefers-reduced-motion: reduce)').matches) return
          h.classList.add('is-source')
          setTimeout(() => h.classList.remove('is-source'), 1100)
        })()
      </script>
      <p class="slogan">{SLOGAN}</p>
      <p class="slogan-en" lang="en">{SLOGAN_EN}</p>
      <DownloadLinks client:idle version={latest.version} date={latest.date} />
      <figure class="shot">
        <Image
          src={readingShot}
          widths={[800, 1200, 1600, 2400]}
          sizes="(max-width: 1264px) calc(100vw - 64px), 1200px"
          alt="Marlin 打开一个文件夹：左边文件树，右边排好版的「快速上手」"
          loading="eager"
        />
      </figure>
    </div>
  </section>

  <section class="band alt" id="speed">
    <div class="wrap">
      <h2>双击秒开</h2>
      <p class="sub">不打包浏览器，渲染核心用 Rust 写成。</p>
      <dl class="stats">
        {stats.map(([n, u, l]) => (
          <div>
            <dt>{n}<small>{u}</small></dt>
            <dd>{l}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <div id="features">
    <section class="band" id="edit">
      <div class="wrap">
        <h2>所见即所改</h2>
        <p class="sub">在排好版的正文里直接写。</p>
        <figure class="shot">
          <Image src={liveShot} widths={[800, 1200, 1600, 2400]} sizes="(max-width: 1264px) calc(100vw - 64px), 1200px" alt="Marlin 实时预览：公式已排好版，表格点进一格变成可编辑的网格" loading="lazy" />
        </figure>
      </div>
    </section>

    <section class="band alt" id="board">
      <div class="wrap">
        <h2>画板</h2>
        <p class="sub">流程图、时序图、思维导图，不写代码也能画。</p>
        <figure class="shot">
          <Image src={flowShot} widths={[800, 1200, 1600, 2400]} sizes="(max-width: 1264px) calc(100vw - 64px), 1200px" alt="Marlin 流程图画板：刚加了「通知仓库」节点并换成黄色" loading="lazy" />
        </figure>
        <div class="pair">
          <figure class="shot">
            <Image src={seqShot} widths={[600, 900, 1200]} sizes="(max-width: 760px) calc(100vw - 32px), 584px" alt="Marlin 时序图画板" loading="lazy" />
            <figcaption>时序图</figcaption>
          </figure>
          <figure class="shot">
            <Image src={mindShot} widths={[600, 900, 1200]} sizes="(max-width: 760px) calc(100vw - 32px), 584px" alt="Marlin 思维导图画板" loading="lazy" />
            <figcaption>思维导图</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="band" id="git">
      <div class="wrap">
        <h2>Git 同步</h2>
        <p class="sub">改动一目了然，提交、拉取、推送一键完成。</p>
        <figure class="shot">
          <Image src={gitShot} widths={[800, 1200, 1600, 2400]} sizes="(max-width: 1264px) calc(100vw - 64px), 1200px" alt="Marlin 同步面板：改动的文件和上次提交并排对比" loading="lazy" />
        </figure>
      </div>
    </section>

    <section class="band dark" id="present">
      <div class="wrap">
        <h2>一键放映</h2>
        <p class="sub">按 F5，文档就是幻灯片。</p>
        <figure class="shot">
          <Image src={presentShot} widths={[800, 1200, 1600, 2400]} sizes="(max-width: 1264px) calc(100vw - 64px), 1200px" alt="Marlin 放映中：画笔、荧光笔和激光笔标在流程图上" loading="lazy" />
        </figure>
      </div>
    </section>
  </div>

  <section class="band dark video" id="video" aria-label="功能导览视频">
    <div class="wrap">
      <PromoVideo
        client:visible
        src={video('marlin-tour-1080.mp4')}
        srcSmall={video('marlin-tour-720.mp4')}
        poster={video('marlin-tour-poster.webp')}
        chapters={TOUR_CHAPTERS}
        duration={TOUR_DURATION}
        label="Marlin 功能导览视频"
      />
    </div>
  </section>

  <section class="band" id="more">
    <div class="wrap">
      <h2>更多功能</h2>
      <dl class="more">
        {more.map(([k, v]) => (
          <div>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="band alt" id="faq">
    <div class="wrap">
      <h2>常见问题</h2>
      <div class="qa">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="band dark end">
    <div class="wrap">
      <img src={url('/brand/mark.png')} alt="" width="64" height="54" />
      <h2>免费下载</h2>
      <DownloadLinks client:idle version={latest.version} date={latest.date} />
    </div>
  </section>
</Base>

<style>
  /* 每一段一条通栏色带：白、浅灰、深海交替；内容一律居中 */
  .band {
    padding: 160px 0;
    text-align: center;
    scroll-margin-top: 60px;
  }
  .band.alt {
    background: var(--bg-alt);
  }
  .band.dark {
    background: var(--sea);
    color: var(--on-sea);
    --fg: var(--on-sea);
    --fg-muted: var(--on-sea-muted);
    --border: rgb(255 255 255 / 16%);
    --hover: rgb(255 255 255 / 8%);
    --accent-soft: rgb(255 255 255 / 8%);
  }
  .wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  h2 {
    font-size: clamp(28px, 3.6vw, 48px);
    letter-spacing: -0.025em;
    line-height: 1.15;
    text-wrap: balance;
  }
  .sub {
    margin-top: 14px;
    font-size: clamp(17px, 1.4vw, 19px);
    font-weight: 500;
    color: var(--fg-muted);
    text-wrap: balance;
  }

  /* 截图：细边框、大圆角、一层很淡的投影 */
  .shot {
    width: 100%;
    margin: 72px 0 0;
  }
  .shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 16px;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
  }

  /* 首屏 */
  .hero {
    padding-top: 128px;
    padding-bottom: 0;
    background: linear-gradient(var(--bg) 66%, var(--bg-alt) 66%);
  }
  .name {
    font-size: clamp(56px, 8.5vw, 112px);
    line-height: 1;
    letter-spacing: -0.05em;
    font-weight: 700;
    transition: font-weight 0.35s ease, letter-spacing 0.35s ease;
  }
  .name .mk {
    display: inline-block;
    max-width: 0;
    overflow: hidden;
    vertical-align: bottom;
    opacity: 0;
    font: 400 0.7em var(--font-mono);
    color: var(--fg-muted);
    transition: max-width 0.35s ease, opacity 0.25s ease;
  }
  .name .caret {
    display: inline-block;
    width: 0.04em;
    height: 0.8em;
    margin-left: 0.04em;
    vertical-align: -0.04em;
    background: var(--accent);
    opacity: 0;
  }
  .name.is-source {
    font-weight: 400;
    letter-spacing: -0.02em;
  }
  .name.is-source .mk {
    max-width: 1.6em;
    opacity: 1;
  }
  .name.is-source .caret {
    animation: blink 0.9s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 1;
    }
  }
  .slogan {
    margin: 16px 0 0;
    font-size: clamp(20px, 2.2vw, 28px);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .slogan-en {
    margin: 8px 0 36px;
    font-size: clamp(15px, 1.3vw, 17px);
    font-weight: 500;
    color: var(--fg-muted);
  }
  .band :global(.dl) {
    align-items: center;
    text-align: center;
  }
  .band :global(.dl .actions) {
    justify-content: center;
  }
  .band :global(.dl .meta) {
    max-width: none;
    margin-top: 18px;
  }
  .band :global(.dl .more-link) {
    margin-left: 1em;
  }
  /* 下载按钮：胶囊形，比正文按钮大一号 */
  .band :global(.dl .btn-primary) {
    padding: 14px 34px;
    font-size: 17px;
    border-radius: 999px;
  }

  /* 速度：三个数字 */
  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 48px;
    width: 100%;
    max-width: 960px;
    margin: 80px 0 0;
  }
  .stats dt {
    font-size: clamp(44px, 4.8vw, 64px);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .stats small {
    margin-left: 0.12em;
    font-size: 0.36em;
    letter-spacing: 0;
    color: var(--accent);
  }
  .stats dd {
    margin: 14px 0 0;
    font-size: 17px;
    color: var(--fg-muted);
  }

  /* 画板：大图下面两张并排 */
  .pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
    width: 100%;
  }
  .pair .shot {
    margin-top: 32px;
  }
  .pair figcaption {
    margin-top: 16px;
    font-size: 17px;
    font-weight: 600;
  }

  /* 视频紧跟在放映后面，同一条深色带 */
  .video {
    padding-top: 0;
  }
  .video .wrap > :global(*) {
    width: 100%;
    text-align: left;
  }

  /* 还有更多 */
  .more {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 56px 48px;
    width: 100%;
    max-width: 960px;
    margin: 80px 0 0;
  }
  .more dt {
    font-size: 21px;
    font-weight: 600;
  }
  .more dd {
    margin: 6px 0 0;
    color: var(--fg-muted);
  }

  /* 常见问题：左对齐才好读 */
  .qa {
    width: 100%;
    max-width: 760px;
    margin-top: 64px;
    text-align: left;
  }
  .qa details {
    border-top: 1px solid var(--border);
  }
  .qa details:last-child {
    border-bottom: 1px solid var(--border);
  }
  .qa summary {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 22px 0;
    font-size: 18px;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }
  .qa summary::-webkit-details-marker {
    display: none;
  }
  .qa summary::after {
    content: '+';
    flex: none;
    font-weight: 400;
    font-size: 22px;
    line-height: 1;
    color: var(--fg-muted);
  }
  .qa details[open] summary::after {
    content: '−';
  }
  .qa details p {
    padding: 0 40px 24px 0;
    color: var(--fg-muted);
  }

  /* 收尾 */
  .end img {
    margin-bottom: 32px;
    filter: brightness(0) invert(1);
    opacity: 0.9;
  }
  .end h2 {
    margin-bottom: 48px;
  }
  .end :global(.dl a:not(.btn)) {
    color: var(--on-sea);
  }

  @media (max-width: 1000px) {
    .band {
      padding: 112px 0;
    }
    .hero,
    .video {
      padding-top: 88px;
      padding-bottom: 0;
    }
    .video {
      padding-top: 0;
      padding-bottom: 112px;
    }
    .shot {
      margin-top: 48px;
    }
  }
  @media (max-width: 760px) {
    .band {
      padding: 88px 0;
    }
    .hero {
      padding-top: 64px;
      padding-bottom: 0;
      background: linear-gradient(var(--bg) 72%, var(--bg-alt) 72%);
    }
    .video {
      padding-top: 0;
      padding-bottom: 88px;
    }
    .stats {
      gap: 40px;
      margin-top: 56px;
    }
    .stats,
    .pair,
    .more {
      grid-template-columns: minmax(0, 1fr);
    }
    .more {
      gap: 32px;
      margin-top: 48px;
    }
    .qa details p {
      padding-right: 0;
    }
  }
</style>
